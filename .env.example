NODE_ENV=development
# Optional: debug (development default), info (production default), warn, error.
# LOG_LEVEL=debug
PORT=8080
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Enable after applying migrations and configuring both server-only keys.
ACCOUNT_WITHDRAWAL_ENABLED=false
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# KAKAO_ADMIN_KEY=REPLACE_ME

# Kie API credentials. Model settings: src/config/ai-model.config.ts
WEALTH_RANKING_ENABLED=false
# AI: default/maximum 300 seconds. Queue + preparation + saving: 300 seconds total (5s reserved for saving).
WEALTH_RANKING_TIMEOUT_MS=300000
# Enter the real key in the server root .env, then enable wealth ranking.
KIE_API_KEY=

# Optional official calendar verification (data.go.kr dataset 15012679).
# Enter an approved KASI key in .env and enable after approval; restart the server.
KASI_CALENDAR_VERIFICATION_ENABLED=false
KASI_SERVICE_KEY=
KASI_TIMEOUT_MS=2000

# Optional solar-term/year/month pillar verification (dataset 15012690).
# Public endpoints: src/config/kasi-api.config.ts
KASI_SPECIAL_SERVICE_KEY=
KASI_SOLAR_TERMS_VERIFICATION_ENABLED=false

# PostgreSQL 풀이 작업 처리. DB migration 적용 후 서버를 시작합니다.
# API 전용 인스턴스는 false, 최소 한 개의 상시 실행 인스턴스는 true.
READING_JOBS_WORKER_ENABLED=true
